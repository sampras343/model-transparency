"""python-conformance — model-signing conformance adapter for Python.

Translates the conformance protocol to the model_signing Python CLI.
This script is used as the --entrypoint for the model-signing-conformance
test suite.

Usage:
    python-conformance sign-model --method key|certificate|sigstore \\
                       --model-path DIR --output-bundle FILE \\
                       [--private-key PEM] [--signing-cert PEM] \\
                       [--cert-chain PEM...] [--ignore-paths PATH...] \\
                       [--identity-token TOKEN] [--use-staging]

    python-conformance verify-model --method key|certificate|sigstore \\
                       --model-path DIR --bundle FILE \\
                       [--public-key PEM] [--cert-chain PEM...] \\
                       [--ignore-paths PATH...] [--ignore-unsigned-files] \\
                       [--identity ID] [--identity-provider URL] [--use-staging]

The adapter calls `python -m model_signing` (or MODEL_SIGNING_PYTHON env var).
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys


def _python() -> str:
    """Return the Python interpreter to use for model_signing."""
    return os.environ.get("MODEL_SIGNING_PYTHON", sys.executable)


def cmd_sign(args: argparse.Namespace) -> int:
    cmd = [_python(), "-m", "model_signing", "sign", args.method,
           "--signature", args.output_bundle]

    if args.method == "key":
        if not args.private_key:
            print("ERROR: --private-key required for method=key", file=sys.stderr)
            return 2
        cmd += ["--private-key", args.private_key]

    elif args.method == "certificate":
        if not args.private_key:
            print("ERROR: --private-key required for method=certificate", file=sys.stderr)
            return 2
        if not args.signing_cert:
            print("ERROR: --signing-cert required for method=certificate", file=sys.stderr)
            return 2
        cmd += ["--private-key", args.private_key]
        cmd += ["--signing-certificate", args.signing_cert]
        for chain_cert in (args.cert_chain or []):
            cmd += ["--certificate-chain", chain_cert]

    elif args.method == "sigstore":
        if args.identity_token:
            cmd += ["--identity-token", args.identity_token]
        if args.use_staging:
            cmd += ["--use-staging"]

    else:
        print(f"ERROR: Unknown method: {args.method}", file=sys.stderr)
        return 2

    for ignore_path in (args.ignore_paths or []):
        cmd += ["--ignore-paths", ignore_path]

    cmd += [args.model_path]

    result = subprocess.run(cmd)
    return result.returncode


def cmd_verify(args: argparse.Namespace) -> int:
    cmd = [_python(), "-m", "model_signing", "verify", args.method,
           "--signature", args.bundle]

    if args.method == "key":
        if not args.public_key:
            print("ERROR: --public-key required for method=key", file=sys.stderr)
            return 2
        cmd += ["--public-key", args.public_key]

    elif args.method == "certificate":
        for chain_cert in (args.cert_chain or []):
            cmd += ["--certificate-chain", chain_cert]

    elif args.method == "sigstore":
        if args.identity:
            cmd += ["--identity", args.identity]
        if args.identity_provider:
            cmd += ["--identity-provider", args.identity_provider]
        if args.use_staging:
            cmd += ["--use-staging"]

    else:
        print(f"ERROR: Unknown method: {args.method}", file=sys.stderr)
        return 2

    for ignore_path in (args.ignore_paths or []):
        cmd += ["--ignore-paths", ignore_path]

    if args.ignore_unsigned_files:
        cmd += ["--ignore-unsigned-files"]

    cmd += [args.model_path]

    result = subprocess.run(cmd)
    return result.returncode


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="python-conformance",
        description="model-signing conformance adapter (Python)",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    sign_parser = subparsers.add_parser("sign-model")
    sign_parser.add_argument("--method", required=True,
                             choices=["key", "certificate", "sigstore"])
    sign_parser.add_argument("--model-path", required=True)
    sign_parser.add_argument("--output-bundle", required=True)
    sign_parser.add_argument("--private-key")
    sign_parser.add_argument("--signing-cert")
    sign_parser.add_argument("--cert-chain", action="append", default=[])
    sign_parser.add_argument("--ignore-paths", action="append",
                             dest="ignore_paths", default=[])
    sign_parser.add_argument("--identity-token")
    sign_parser.add_argument("--use-staging", action="store_true")

    verify_parser = subparsers.add_parser("verify-model")
    verify_parser.add_argument("--method", required=True,
                               choices=["key", "certificate", "sigstore"])
    verify_parser.add_argument("--model-path", required=True)
    verify_parser.add_argument("--bundle", required=True)
    verify_parser.add_argument("--public-key")
    verify_parser.add_argument("--cert-chain", action="append", default=[])
    verify_parser.add_argument("--ignore-paths", action="append",
                               dest="ignore_paths", default=[])
    verify_parser.add_argument("--ignore-unsigned-files", action="store_true")
    verify_parser.add_argument("--identity")
    verify_parser.add_argument("--identity-provider")
    verify_parser.add_argument("--use-staging", action="store_true")

    args = parser.parse_args()

    if args.command == "sign-model":
        return cmd_sign(args)
    elif args.command == "verify-model":
        return cmd_verify(args)
    return 1


if __name__ == "__main__":
    sys.exit(main())
